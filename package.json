{
  "name": "dsh-image-canvas",
  "version": "1.3.0",
  "description": "Infinite canvas for AI image work in DeepSeek Harness: text-to-image, image-to-image, upload, crop, preview and generation history.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaochangsheng0828/dsh-image-canvas.git"
  },
  "homepage": "https://github.com/gaochangsheng0828/dsh-image-canvas#readme",
  "bugs": {
    "url": "https://github.com/gaochangsheng0828/dsh-image-canvas/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "image-generation",
    "infinite-canvas",
    "text-to-image",
    "image-to-image"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
